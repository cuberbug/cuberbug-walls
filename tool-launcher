#!/usr/bin/env bash
set -o errexit
set -o nounset
set -o pipefail

VERSION="1.2.2"

# Режим отладки (включается при запуске с ключом '--debug' или '-d')
unset DEBUG


# == Оформление вывода ==
BOLD="\e[1m"
NO_BOLD="\e[22m"

RED="\e[31m"
GREEN="\e[32m"
YELLOW="\e[33m"
BLUE="\e[34m"
NO_COLOR="\e[39m"

# F_RESET="\e[0m"
F_ERROR="[ ${RED}ERROR${NO_COLOR} ] "
F_BLUE="${BOLD}${BLUE} ● ${NO_COLOR}${NO_BOLD}"
F_GREEN="${BOLD}${GREEN} ✔ ${NO_COLOR}${NO_BOLD}"

# Список терминалов для проверки.
# Используется в случае, если не получилось определить терминал по умолчанию.
DEFAULT_TERMINALS=(
  "konsole"        # Многофункциональный терминал для среды KDE
  "gnome-terminal" # Стандартный терминал для среды GNOME
  "gnome-console"  # Легковесный терминал для GNOME, замена gnome-terminal
  "xfce4-terminal" # Легковесный терминал, идущий в комплекте с XFCE
  "kitty"          # Быстрый, настраиваемый терминал с поддержкой GPU
  "alacritty"      # Легковесный, высокопроизводительный терминал с акцентом на простоту
  "xterm"          # Классический, минималистичный терминал для X Window System
)


# === Вспомогательные функции ===

show_help() {
  cat <<EOF
Tool Launcher — универсальный менеджер установки и запуска утилит.
Версия: $VERSION

Описание:
  Скрипт обновляет сабмодуль 'tools' и запускает основной сценарий (./tools/start.sh)
  либо в текущем терминале, либо в новом окне терминала в зависимости от контекста.


Использование:
  $(basename "$0") [опции]


Опции:
  -h, --help       Показать эту справку
  -v, --version    Показать версию скрипта
  -d, --debug      Запуск в режиме отладки

Примеры:
  ./$(basename "$0")
      Запускает основной скрипт в текущем терминале или открывает новое окно,
      если запущен вне терминала.

EOF
}

show_hello() {
  cat <<EOF
:::::::::::::::::::::::
:::: Tool Launcher ::::
:::::::::::::::: v${VERSION}

EOF
}


# == Форматирование текста ==
# ---------------------------
# Содержит набор простых функций для оформления выводимого текста:
#   - f_bold:   жирный
#   - f_red:    красный
#   - f_green:  зелёный
#   - f_yellow: жёлтый
#   - f_blue:   синий
# ---------------------------
# Пример использования:
#   echo -e "Вывод $(f_red "красного") и $(f_green "зелёного") текста"
# ---------------------------

_format() {
  local start_code=$1
  local end_code=$2
  shift 2

  echo -en "${start_code}$*${end_code}"
}

f_bold()   { _format "$BOLD"   "$NO_BOLD"  "$@"; }
f_red()    { _format "$RED"    "$NO_COLOR" "$@"; }
f_green()  { _format "$GREEN"  "$NO_COLOR" "$@"; }
f_yellow() { _format "$YELLOW" "$NO_COLOR" "$@"; }
f_blue()   { _format "$BLUE"   "$NO_COLOR" "$@"; }


# === Вывод отладочной информации ===
# -----------------------------------
# Работает только в случае, если скрипт запущен в режиме отладки,
# то есть с флагами -d или --debug.
#
# Использование: log_debug "Сообщение"
# -----------------------------------
log_debug() {
  if [[ -v DEBUG ]]; then
    echo -e "[ $(f_yellow "DEBUG") ] $*" >&2
  fi
}


# === Инициализация окружения ===
init_env() {
  if ! command -v git >/dev/null 2>&1; then
    echo -e "${F_ERROR}Не найден git. Установите его, чтобы использовать этот скрипт." >&2
    exit 1
  fi

  MAIN_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  cd "$MAIN_PATH" || exit 1

  # Хранит название конфигурации из .gitmodules для использования
  REPO_TOOLS_NAME="tools"
  REPO_ROOT="$(git -C "$MAIN_PATH" rev-parse --show-toplevel)"
  TARGET_SCRIPT="${REPO_ROOT}/tools/start"
  DE=""

  log_debug "Рабочая директория: $(f_bold "$MAIN_PATH")"
  log_debug "Целевой скрипт: $(f_bold "$TARGET_SCRIPT")"
}


# === Функции определения DE ===
# ------------------------------
# Поддерживаются:
#   - KDE Plasma
#   - GNOME
#   - XFCE
# ------------------------------

is_kde() {
  if [[ "${XDG_CURRENT_DESKTOP:-}" == *"KDE"* ]] ||
    [[ "${DESKTOP_SESSION:-}" == "plasma" ]] ||
    [[ "${KDE_FULL_SESSION:-}" == "true" ]] ||
    pgrep -x "plasmashell" >/dev/null 2>&1; then
    DE="KDE Plasma"
    log_debug "Обнаружено окружение: $(f_bold "$DE")"
    return 0
  fi
  return 1
}

is_gnome() {
  local desktop_env="${XDG_CURRENT_DESKTOP:-}"

  if [[ "$desktop_env" == *"GNOME"* ]] ||
    [[ "$desktop_env" == *"MATE"* ]] ||
    [[ "${DESKTOP_SESSION:-}" == "gnome" ]] ||
    pgrep -x "gnome-shell" >/dev/null 2>&1; then
    DE="GNOME"
    log_debug "Обнаружено окружение: $(f_bold "$DE")"
    return 0
  fi
  return 1
}

is_xfce() {
  if [[ "${XDG_CURRENT_DESKTOP:-}" == *"XFCE"* ]] ||
    [[ "${DESKTOP_SESSION:-}" == "xfce" ]] ||
    pgrep -fx "xfce4-session" >/dev/null 2>&1; then
    DE="XFCE"
    log_debug "Обнаружено окружение: $(f_bold "$DE")"
    return 0
  fi
  return 1
}


# === Вспомогательные функции поиска терминала ===
# ------------------------------------------------
# Каждая из функций  пытается найти терминал по умолчанию в своём DE.
#
# Возвращает: путь до установленного пользователем терминала по умолчанию
#             или путь до дефолтного терминала.
# ------------------------------------------------

get_kde_default_terminal() {
  local term_bin kconfig_cmd

  if command -v kreadconfig6 >/dev/null 2>&1; then
    kconfig_cmd="kreadconfig6"
  elif command -v kreadconfig5 >/dev/null 2>&1; then
    kconfig_cmd="kreadconfig5"
  fi

  if [[ -n "$kconfig_cmd" ]]; then
    log_debug "Чтение конфига $(f_bold "$DE") через $(f_bold "$kconfig_cmd")..."
    term_bin="$($kconfig_cmd --file kdeglobals --group General --key TerminalApplication)"

    if [[ -n "$term_bin" ]]; then
      log_debug "Конфигурация вернула: $(f_green "$term_bin")"
      echo "$term_bin"
      return 0
    else
      log_debug "Ключ $(f_bold "TerminalApplication") пуст или не найден."
    fi
  else
    log_debug "Утилиты $(f_bold "kreadconfig") не найдены."
  fi

  # Попытка вернуть дефолт для KDE
  if term_bin=$(command -v konsole) && [[ -n "$term_bin" ]]; then
    log_debug "Возврат дефолтного терминала для $(f_bold "$DE")"
    echo "$term_bin"
    return 0
  fi

  echo -e "${F_ERROR}Не удалось определить терминал для $(f_bold "$DE")" >&2
  return 1
}

get_gnome_default_terminal() {
  local term_bin

  if command -v gsettings >/dev/null 2>&1; then
    log_debug "Запрос $(f_bold "'gsettings get ...'")"
    term_bin="$(gsettings get org.gnome.desktop.applications terminal exec 2>/dev/null)"
    term_bin="${term_bin//\'/}"  # Удаление кавычек
    term_bin="${term_bin%% *}"   # Берёт только первый токен (на случай аргументов)

    if [[ -n "$term_bin" ]]; then
      if command -v "$term_bin" &>/dev/null; then
        log_debug "gsettings вернул: $(f_green "$term_bin")"
        echo "$term_bin"
        return 0
      fi
    fi
  else
    log_debug "Утилита $(f_bold "gsettings") не найдена."
  fi

  # Попытка вернуть дефолт для GNOME
  if term_bin=$(command -v gnome-terminal) && [[ -n "$term_bin" ]]; then
    log_debug "Возврат дефолтного терминала для $(f_bold "$DE")"
    echo "$term_bin"
    return 0
  fi

  echo -e "${F_ERROR}Не удалось определить терминал для $(f_bold "$DE")" >&2
  return 1
}

get_xfce_default_terminal() {
  local config_file="$HOME/.config/xfce4/helpers.rc"
  local term_bin

  # XFCE хранит настройки приложений по умолчанию (через exo) в helpers.rc
  if [[ -f "$config_file" ]]; then
    log_debug "Чтение файла: $(f_bold "$config_file")"
    term_bin=$(grep "^TerminalEmulator=" "$config_file" | cut -d'=' -f2)
    log_debug "Найдено значение $(f_bold "TerminalEmulator"): $(f_green "$term_bin")"
  else
    log_debug "Файл конфигурации $(f_bold "$config_file") не найден."
  fi

  # Проверка значения из 'helpers.rc'
  if [[ -n "$term_bin" ]] && command -v "$term_bin" >/dev/null 2>&1; then
    log_debug "$(f_bold "helpers.rc") вернул: $(f_green "$term_bin")"
    echo "$term_bin"
    return 0
  # Или 'custom-TerminalEmulator.desktop'
  elif [[ "$term_bin" == "custom-TerminalEmulator" ]]; then
    local custom_helper="$HOME/.local/share/xfce4/helpers/custom-TerminalEmulator.desktop"

    log_debug "Обнаружен $(f_bold "custom-TerminalEmulator")," \
              "запуск проверки: $(f_bold "$custom_helper")"

    if [[ -f "$custom_helper" ]]; then
      local custom_cmd

      custom_cmd=$(grep "^Bin=" "$custom_helper" | cut -d'=' -f2 | awk '{print $1}')
      log_debug "Извлечена команда из desktop-файла: $(f_bold "$custom_cmd")"

      if [[ -n "$custom_cmd" ]] && command -v "$custom_cmd" >/dev/null 2>&1; then
        log_debug "$(f_bold "custom-TerminalEmulator.desktop") вернул: $(f_green "$custom_cmd")"
        echo "$custom_cmd"
        return 0
      fi
    fi
  fi

  # Попытка вернуть дефолт для XFCE
  if term_bin=$(command -v xfce4-terminal) && [[ -n "$term_bin" ]]; then
    log_debug "Возврат дефолтного терминала для $(f_bold "$DE")"
    echo "$term_bin"
    return 0
  fi

  # Если совсем ничего не нашли (крайний случай)
  echo -e "${F_ERROR}Не удалось определить терминал для $(f_bold "$DE")" >&2
  return 1
}


# === Главная функция поиска терминала ===
# ----------------------------------------
# Ищет терминал, подходящий для запуска основного скрипта в новом окне.
#
# Проверяет, поддерживается ли DE пользователя.
#   Если да: ищет терминал по умолчанию для DE.
#   Если нет: ищет в списке поддерживаемых терминалов.
#
# Возвращает: путь до бинарника терминала.
# ----------------------------------------
find_terminal() {
  local terminal

  # Попытка определить через DE
  if is_kde; then
    terminal="$(get_kde_default_terminal)"
  elif is_gnome; then
    terminal="$(get_gnome_default_terminal)"
  elif is_xfce; then
    terminal="$(get_xfce_default_terminal)"
  fi

  if [[ -n "$terminal" ]]; then
    log_debug "Для $(f_bold "$DE") используется терминал: $(f_bold "$terminal")"
    echo "$terminal"
    return 0
  fi

  log_debug "Не удалось определить DE или терминал для него. Перебор списка по умолчанию..."

  # Если DE пользователя не поддерживается
  for terminal in "${DEFAULT_TERMINALS[@]}"; do
    if command -v "$terminal" &>/dev/null; then
      log_debug "Найден терминал из списка: $(f_bold "$terminal")"
      echo "$terminal"
      return 0
    fi
  done

  return 1
}


# === Запуск скрипта в новом окне терминала ===
# ---------------------------------------------
# Запускает указанный скрипт в новом окне терминала.
#   $1 — путь до исполняемого файла (обязательно)
# ---------------------------------------------
run_in_terminal() {
  if [[ $# -ne 1 ]]; then
    echo -e "${F_ERROR}$(f_bold 'run_in_terminal()') требует 1 аргумент — путь до скрипта." >&2
    return 1
  fi
  local path_to_script=$1
  local terminal
  local term_name
  local args=()

  if [[ ! -f "$path_to_script" ]]; then
    echo -e "${F_ERROR}Файл $(f_bold "$path_to_script") не существует." >&2
    return 1
  fi

  terminal=$(find_terminal)
  if [[ -z "$terminal" ]]; then
    echo -e "${F_ERROR}Не удалось найти поддерживаемый эмулятор терминала." >&2
    exit 1
  fi

  term_name="${terminal##*/}"

  echo -e "${F_GREEN}Запуск $(f_bold "$path_to_script") в новом окне ($(f_bold "$term_name"))..."

  # Применяет правильный ключ в зависимости от терминала
  case "$term_name" in
    # --- Группа GNOME (требуют '--') ---
    # gnome-terminal: флаг -x удален, флаг -e deprecated. Используем --
    # gnome-console (kgx): принимает только --
    # tilix: аналогично gnome-terminal
    gnome-terminal|gnome-console|tilix)
      args=("--" "$path_to_script")
      ;;

    # --- Mate Terminal ---
    # Часто ведет себя как старый гном.
    # Флаг -e надежнее всего работает на старых и новых версиях Mate.
    # Вариант с -- может просто открыть shell, игнорируя команду в старых версиях.
    mate-terminal)
      args=("-e" "$path_to_script")
      ;;

    # --- Группа XFCE / Terminator ---
    # xfce4-terminal: поддерживает -x (execute remainder), это избавляет от проблем с кавычками.
    # terminator: аналогично, -x работает стабильнее, чем -e.
    terminator|xfce4-terminal)
      args=("-x" "$path_to_script")
      ;;

    # --- Kitty ---
    # Kitty не требует флага -e, она принимает скрипт как аргумент.
    kitty)
      args=("$path_to_script")
      ;;

    # --- Стандартные терминалы (флаг -e) ---
    # Konsole: флаг -e является стандартом.
    # Alacritty: флаг -e обязателен (в старых версиях), в новых (v0.13+) тоже работает.
    # xterm/urxvt/rxvt/st: классика, только -e.
    konsole|alacritty|xterm|urxvt|rxvt|st)
      args=("-e" "$path_to_script")
      ;;

    # Fallback
    *)
      #log_debug "${YELLOW}Неизвестный терминал '$terminal', используется стандартный флаг -e${F_RESET}"
      log_debug "$(f_yellow "Неизвестный терминал $(f_bold "$terminal")," \
                "используется стандартный флаг -e")"
      args=("-e" "$path_to_script")
      ;;
  esac

  log_debug "Выполняется команда: $(f_bold "$terminal ${args[*]}")"

  # Запуск
  "$terminal" "${args[@]}"
}


# === Работа с сабмодулем ===
# ---------------------------
# Обновляет сабмодуль до актуального состояния
#   $1 — название сабмодуля из конфигурации .gitmodules (обязательно)
# ---------------------------
update_submodule() {
  if [[ $# -ne 1 ]]; then
    echo "${F_ERROR}update_submodule() требует 1 аргумент — путь до сабмодуля." >&2
    return 1
  fi
  local submodule_name=$1

  echo -e "${F_BLUE}Проверка и обновление сабмодуля $(f_bold "$submodule_name")..."

  if ! git submodule update --init --remote -- "$submodule_name"; then
    echo "Ошибка: Не удалось обновить сабмодуль $submodule_name." >&2
    return 1
  fi

  echo -e "${F_GREEN}$(f_green "Сабмодуль успешно обновлен или уже актуален")"
}


# === Основная логика ===
# -----------------------
# - обрабатывает полученные при запуске ключи
# - выводит информацию о скрипте
# - устанавливает окружение (переменные)
# - обновляет сабмодуль
# - запускает целевой скрипт из сабмодуля или ищет терминал для запуска в окне
# -----------------------

# --- Обработка вариантов запуска с ключами ---
while [[ $# -gt 0 ]]; do
  case "${1:-}" in
    -h|--help) show_help; exit 0 ;;
    -v|--version) echo "v$VERSION"; exit 0 ;;
    -d|--debug) DEBUG=1; shift ;;
    -*)
      echo "Неизвестная опция: $1. Используйте --help для справки." >&2
      exit 1
      ;;
  esac
done


# === Запуск ===

show_hello
init_env
update_submodule "$REPO_TOOLS_NAME"


if [[ -v DEBUG ]]; then
  log_debug "$(f_blue "Запуск в режиме отладки") (открытие нового окна принудительно)"
  run_in_terminal "$TARGET_SCRIPT"
  exit 0
fi

# Если код выполняется в окне терминала, то запустит следующий скрипт в нём
if test -t 0; then
  echo -e "${F_GREEN}Запуск интерактивного меню..."
  $TARGET_SCRIPT
  exit 0
fi

# Иначе: запустит скрипт в новом окне терминала
run_in_terminal "$TARGET_SCRIPT"
