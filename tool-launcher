#!/usr/bin/env bash
# =============================================================================
# Tool Launcher — Точка входа
# =============================================================================
# Главный исполняемый файл. Связывает модули, настраивает окружение,
# обновляет зависимости и запускает целевое приложение в нужном контексте
# (терминал или GUI).
# =============================================================================


set -o errexit
set -o nounset
set -o pipefail


SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly SRC_DIR="$SCRIPT_DIR/launcher"

# shellcheck source=launcher/ui.sh
source "$SRC_DIR/ui.sh"
# shellcheck source=launcher/env.sh
source "$SRC_DIR/env.sh"
# shellcheck source=launcher/git.sh
source "$SRC_DIR/git.sh"
# shellcheck source=launcher/find_terminal.sh
source "$SRC_DIR/find_terminal.sh"
# shellcheck source=launcher/de.sh
source "$SRC_DIR/de.sh"


# =============================
# 1. Инициализация и настройка
# =============================

# Разбор аргументов CLI (включая флаги --debug, --branch и др.)
parse_args "$@"

# Настройка цветов вывода (учитывает флаги и системное окружение)
init_format

# Вывод приветственного логотипа
show_hello

# Подготовка переменных окружения (пути, имена веток, названия скриптов)
validate_environment
init_env
init_target_args


# =============================
# 2. Обновление зависимостей
# =============================

# Проверяет и обновляет сабмодуль 'tools'.
# Ветка выбирается динамически: main (по умолчанию) или указанная через --branch (-b).
update_submodule "$REPO_TOOLS_PATH" "$REPO_ROOT" "$TARGET_BRANCH"

if [[ ! -x "$TARGET_SCRIPT" ]]; then
  p_error "Файл $(f_bold "$TARGET_SCRIPT") не существует или не исполняемый."
  exit 1
fi

# =============================
# 3. Запуск приложения
# =============================

# Сценарий A: интерактивный запуск в текущем терминале.
# Условие проверяем первым: debug-режим с флагом --no-window
# (DEBUG_FORCE_WINDOW == 0) тоже должен попасть сюда, если мы в терминале.
if ! { is_debug && (( DEBUG_FORCE_WINDOW == 1 )); } && [[ -t 0 ]]; then
  p_info 'Запуск интерактивного меню...'
  exec "$TARGET_SCRIPT" "${TARGET_ARGS[@]}"
fi

# Сценарии B и C: запуск в новом окне терминала
# (принудительно в режиме отладки либо потому, что мы запущены из GUI).
declare -a term_cmd=()
build_terminal_cmd term_cmd "$TARGET_SCRIPT" "${TARGET_ARGS[@]}" || exit 1

if is_debug && (( DEBUG_FORCE_WINDOW == 1 )); then
  p_debug "$(f_bold 'Запуск в режиме отладки') (открытие нового окна принудительно)"
fi
p_done "Запуск в новом окне ($(f_bold "${term_cmd[0]##*/}"))..."
p_debug "Выполняется команда: $(f_bold "${term_cmd[*]}")"

exec "${term_cmd[@]}"
