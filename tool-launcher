#!/usr/bin/env bash
# =============================================================================
# Tool Launcher — Точка входа
# =============================================================================
# Главный исполняемый файл. Связывает модули, настраивает окружение,
# обновляет зависимости и запускает целевое приложение в нужном контексте
# (терминал или GUI).
# =============================================================================


set -o errexit
set -o nounset
set -o pipefail


SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC_DIR="$SCRIPT_DIR/launcher"

# shellcheck source=launcher/ui.sh
source "$SRC_DIR/ui.sh"
# shellcheck source=launcher/env.sh
source "$SRC_DIR/env.sh"
# shellcheck source=launcher/git.sh
source "$SRC_DIR/git.sh"
# shellcheck source=launcher/find_terminal.sh
source "$SRC_DIR/find_terminal.sh"
# shellcheck source=launcher/de.sh
source "$SRC_DIR/de.sh"


# =============================
# 1. Инициализация и настройка
# =============================

# Разбор аргументов CLI (включая флаги --debug, --branch и др.)
parse_args "$@"

# Настройка цветов вывода (учитывает флаги и системное окружение)
init_format

# Вывод приветственного логотипа
show_hello

# Подготовка переменных окружения (пути, имена веток, названия скриптов)
init_env


# =============================
# 2. Обновление зависимостей
# =============================

# Проверяет и обновляет сабмодуль 'tools'.
# Ветка выбирается динамически: main (по умолчанию) или указанная через --branch (-b).
update_submodule "$REPO_TOOLS_PATH" "$REPO_ROOT" "$TARGET_BRANCH"


# =============================
# 3. Запуск приложения
# =============================

# Сценарий A: Режим отладки с принудительным новым окном.
# Срабатывает, если задан флаг --debug (-d), но НЕ задан --no-window (-W).
if [[ -v DEBUG && $DEBUG_FORCE_WINDOW -eq 1 ]]; then
  e_debug "$(f_bold "Запуск в режиме отладки") (открытие нового окна принудительно)"
  run_in_terminal "$TARGET_SCRIPT" "${TARGET_ARGS[@]}"
  exit 0
fi

# Сценарий B: Интерактивный запуск.
# Срабатывает, если скрипт запущен внутри уже открытого терминала.
# Запускает целевой скрипт прямо здесь (inline), сохраняя текущую сессию.
if test -t 0; then
  e_info "Запуск интерактивного меню..."
  $TARGET_SCRIPT "${TARGET_ARGS[@]}"
  exit 0
fi

# Сценарий C: Запуск из GUI (например, клик по иконке).
# Если мы не в терминале и не в особом режиме отладки — ищем эмулятор терминала
# и запускаем скрипт в новом окне.
run_in_terminal "$TARGET_SCRIPT" "${TARGET_ARGS[@]}"
